generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int            @id @default(autoincrement())
  login        String         @unique
  nickname     String?
  totalWins    Int            @default(0)
  password     String         //probably because idk rn
  session      GameSession[]  //this will connect players to sessions, i guess
  hostedGames  GameSession[]  @relation("GameHost")
}

model GameSession {
  id           Int      @id @default(autoincrement())
  sessionName  String
  status       String   @default("LOBBY") //all options: "LOBBY" "PLAYING" "ENDED"
  isPrivate    Boolean  @default(false)
  password     String?
  maxPlayers   Int      @default(4)
  players      User[]   //players ids will save here and it will show all the players when we will open the statistic
  hostId       Int
  host         User     @relation("GameHost", fields: [hostId], references: [id]) //this shi must give the id of host player, so he can change setting of game
}